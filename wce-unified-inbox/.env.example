# =========================================================================
# WCE Unified Inbox — environment
# Copy to `.env` and fill in. `.env` is gitignored. NEVER commit real keys.
# =========================================================================

# --- Supabase (project: "WCE App") ---
# Server-side ONLY (the Node mirror / sync). The service role key bypasses RLS.
# Never expose this to the browser or commit it.
SUPABASE_URL=https://dexdftcmcixppbuucjfd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__server_side_only_paste_service_role_key__

# Browser (Vite) — safe-to-ship publishable/anon key.
VITE_SUPABASE_URL=https://dexdftcmcixppbuucjfd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_PxVHu14KHo8fS1VqGleq7g_M6XmojRv

# --- Beeper Desktop bridge (runs on your always-on machine) ---
# Token: Beeper Desktop -> Settings -> Integrations -> Approved connections -> "+"
BEEPER_BASE_URL=http://localhost:23373
BEEPER_ACCESS_TOKEN=__paste_approved_connection_token__
BEEPER_API_VERSION=v1            # v1 (current) | v0 (deprecated fallback)

# --- Sync behaviour ---
SYNC_INTERVAL_MS=15000           # poll cadence for the inbound mirror
SYNC_LOOKBACK_DAYS=30            # how far back to pull on each run

# --- Send windows (local time, HH:MM) ---
# Outreach window: proactive invite blasts (is_outreach batches) only fire in
# this window. Replies/confirmations are exempt.
OUTREACH_START=10:00
OUTREACH_CUTOFF=16:30
# Hard quiet hours: NO outbound of ANY kind in this window — batches, approved
# drafts, auto-replies, digests, group posts. Nothing is exempt. Queued sends
# hold and flush when the window ends.
QUIET_START=21:00
QUIET_END=09:00

# --- AI drafting (optional) ---
# Leave ANTHROPIC_API_KEY unset to disable. When set, the sync loop generates
# suggested replies into inbox_drafts as `pending` for you to edit/approve.
ANTHROPIC_API_KEY=               # sk-ant-... (server-side only; never the browser)
ANTHROPIC_MODEL=claude-opus-4-8  # drafting model
DRAFT_MAX_PER_PASS=5             # cap on suggestions generated per sync pass

# --- Airtable Player Outreach CRM (optional) ---
# Leave AIRTABLE_API_KEY unset to disable. When set, the sync mirrors the
# "Player Outreach" table into inbox_outreach for batch targeting (segment by
# region/stakes/activity; send to players that have a Beeper Chat ID).
AIRTABLE_API_KEY=                # Airtable personal access token (pat...), read scope on the base
AIRTABLE_BASE_ID=appTPf6j5S1MdNXEf       # "West Coast Event Management"
AIRTABLE_OUTREACH_TABLE=Player Outreach  # table name
OUTREACH_SYNC_MINUTES=10         # how often to re-pull the CRM

# --- Receipt extraction guardrail ---
# The recipient/operator signs every banking slip, so never extract them as a
# player. Comma-separated; matched case-insensitively. Add other staff here.
RECEIPT_BLOCK_NAMES=justin lewis,jj lewis,j j lewis,lewis,justin
RECEIPT_BLOCK_PHONES=0466360662
# Receipt OCR model (defaults to ANTHROPIC_MODEL). Use a cheaper one for big
# backlog sweeps without downgrading AI drafting:
RECEIPTS_MODEL=claude-haiku-4-5
